{
  "name": "prompt-pad",
  "private": true,
  "version": "0.1.0",
  "description": "Prompt Pad —— 常驻 Windows 系统最上层、全局热键唤起、带私人记忆的提示词优化 Pad",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "tauri": "tauri",
    "icons": "node scripts/gen-icons.mjs",
    "check:rust": "node scripts/check-rust-balance.mjs src-tauri/src",
    "check:geometry": "node scripts/check-geometry.mjs",
    "check:db": "node scripts/check-db-sql.mjs",
    "check:docs": "node scripts/check-doc-json.mjs docs",
    "check": "pnpm check:rust && pnpm check:geometry && pnpm check:db && pnpm check:docs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
